\name{print.bastion_fit}
\alias{print.bastion_fit}
\title{Print a BASTION fit}
\description{Display the model priors, sampling settings, credible interval level, and the first five rows of component estimates with their time values.}
\usage{\method{print}{bastion_fit}(x, ...)}
\arguments{
\item{x}{A fitted object of class \code{bastion_fit}.}
\item{...}{Additional arguments passed to printing the component preview.}
}
\value{The fitted object, invisibly.}
